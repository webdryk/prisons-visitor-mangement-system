

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <!-- Font Awesome -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
rel="stylesheet"
/>
<!-- Google Fonts -->
<link
href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"
rel="stylesheet"
/>
<!-- MDB -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.css"
rel="stylesheet"
/>


<style>
    body {
  background-color: #fbfbfb;
}
@media (min-width: 991.98px) {
  main {
    padding-left: 240px;
  }
}

/* Sidebar */
.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  padding: 58px 0 0; /* Height of navbar */
  box-shadow: 0 2px 5px 0 rgb(0 0 0 / 5%), 0 2px 10px 0 rgb(0 0 0 / 5%);
  width: 240px;
  z-index: 600;
}

@media (max-width: 991.98px) {
  .sidebar {
    width: 100%;
  }
}
.sidebar .active {
  border-radius: 5px;
  box-shadow: 0 2px 5px 0 rgb(0 0 0 / 16%), 0 2px 10px 0 rgb(0 0 0 / 12%);
}

.sidebar-sticky {
  position: relative;
  top: 0;
  height: calc(100vh - 48px);
  padding-top: 0.5rem;
  overflow-x: hidden;
  overflow-y: auto; /* Scrollable contents if viewport is shorter than content. */
}
</style>
    <title>Document</title>
</head>
<body>
    
    <!--Main Navigation-->
<header>
    <!-- Sidebar -->
    <nav id="sidebarMenu" class="collapse d-lg-block sidebar collapse bg-white">
      <div class="position-sticky">
        <div class="list-group list-group-flush mx-3 mt-4">
           <a
            href="/adminDashboard"
            class="list-group-item list-group-item-action py-2 ripple"
            aria-current="true"
          >
            <i class="fas fa-tachometer-alt fa-fw me-3"></i><span>Main dashboard</span>
          </a>
          <a href="/adminDashboard" class="list-group-item list-group-item-action py-2 ripple active">
            <i class="fas fa-chart-area fa-fw me-3"></i><span>Dashboard</span>
          </a>
          <a href="/approvevisit" class="list-group-item list-group-item-action py-2 ripple"
            ><i class="fas fa-building fa-fw me-3"></i><span>Approve Visit</span></a
          >
          <a href="/admincalender" class="list-group-item list-group-item-action py-2 ripple"
          ><i class="fas fa-calendar fa-fw me-3"></i><span>Calendar</span></a
        >
        <a href="/scan" class="list-group-item list-group-item-action py-2 ripple"
          ><i class="fas fa-calendar fa-fw me-3"></i><span>Check Booking</span></a
        >
          <a href="/visithistory" class="list-group-item list-group-item-action py-2 ripple"
            ><i class="fas fa-users fa-fw me-3"></i><span>Visit History</span></a
          >
          <a href="/adminProfile" class="list-group-item list-group-item-action py-2 ripple"
            ><i class="fas fa-lock fa-fw me-3"></i><span>Profile</span></a
          >
          
          <a href="/logout" class="list-group-item list-group-item-action py-2 ripple">
            <i class="fas fa-chart-pie fa-fw me-3"></i><span>LogOut</span>
          </a>
        </div>
      </div>
    </nav>
    <!-- Sidebar -->
  
    <!-- Navbar -->
    <nav id="main-navbar" class="navbar navbar-expand-lg navbar-light bg-white fixed-top">
      
      <!-- Container wrapper -->
      <div class="container-fluid">
        <!-- Toggle button -->
        <button class="navbar-toggler" type="button" data-mdb-toggle="collapse"  data-mdb-target="#sidebarMenu" aria-controls="sidebarMenu"  aria-expanded="false" aria-label="Toggle navigation">
        
          <i class="fas fa-bars"></i>
        </button>
  
        <!-- Brand -->
        <a class="navbar-brand" href="#">
          <img
            src="/images/logo.png"
            height="25"
            alt="MDB Logo"
            loading="lazy"
          />
        </a>
       
  
        
    </nav>
    <!-- Navbar -->
  </header>
  <!--Main Navigation-->
  
  <!--Main layout-->
  <main style="margin-top: 58px;">
    <div class="container card pt-4  ms-5 me-5 ">
        <div class="text-center">
       <h2>Vistor Detail</h2><hr>
    </div>
<div class="" >
    <div class="row">
        <div class="col">
            <Span><strong>Vistor : </strong></Span> <%= finduserWithBooking.fName %> <%= finduserWithBooking.lName %>
        </div>
        <div class="row">
            <div class="col">
                <span><Strong>ID :</Strong></span><%= finduserWithBooking.ID %>
            </div>
            
        </div>
        <div class="row">
            <div class="col">
                <span><Strong>Address :</Strong></span><%= finduserWithBooking.Address %>
            </div>
            
        </div>
    </div>
    <hr>
</div>
<div class="row mb-3">


<div class="">
    <div class="text-center">
        <h5>Booking Info</h5>
    </div>

<div class="row">
    <div class="col">
        <span><Strong>Booking Date :</Strong></span><%= bookingDetails.booking[0].bookDate %>
    </div>
    
</div>
<div class="row">
    <div class="col">
        <span><Strong> Approved Visiting Date :</Strong></span><%= bookingDetails.booking[0].appointmentDate %>
    </div>
    
</div>
<div class="row">
    <div class="col">
        <span><Strong>InMate:</Strong></span> <%= bookingDetails.booking[0].fNameInmate %> <%= bookingDetails.booking[0].lNameInmate %>
    </div>
    
</div>
<div class="row">
    <div class="col">
        <span><Strong>Sentence Year :</Strong></span><%= bookingDetails.booking[0].sentenceyear %>

    </div>
    
</div>
<div class="row">
    <div class="col">
        <span><Strong>Crime:</Strong></span><%= bookingDetails.booking[0].crime %>
    </div>
    
        
   
    
</div>
<div class="row">
    <div class="col">
        <span><Strong>vistor Items  :</Strong></span> <%= bookingDetails.booking[0].items %>
    </div>
    
</div>
<div class="row">
    <div class="col">
        <span><Strong>Additional Info :</Strong></span> <%= bookingDetails.booking[0].additionalInfo %>
    </div>
    
</div>

<div class="row">
    <div class="col">
        <span><Strong>Status :</Strong></span> <%= bookingDetails.booking[0].status %>
    </div>
    
</div>




</div>
       
</div> 
<a href="/scan"  class="btn btn-primary mb-5">Check Another</a> 
        
  </main>
  <!--Main layout-->

<script
  type="text/javascript"
  src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.js"
></script>
</body>
</html>