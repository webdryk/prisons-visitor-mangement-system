<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <!-- Font Awesome -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
rel="stylesheet"
/>
<!-- Google Fonts -->
<link
href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"
rel="stylesheet"
/>
<!-- MDB -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.css"
rel="stylesheet"
/>

<style>
    body {
  background-color: #fbfbfb;
}
@media (min-width: 991.98px) {
  main {
    padding-left: 240px;
  }
}

/* Sidebar */
.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  padding: 58px 0 0; /* Height of navbar */
  box-shadow: 0 2px 5px 0 rgb(0 0 0 / 5%), 0 2px 10px 0 rgb(0 0 0 / 5%);
  width: 240px;
  z-index: 600;
}

@media (max-width: 991.98px) {
  .sidebar {
    width: 100%;
  }
}
.sidebar .active {
  border-radius: 5px;
  box-shadow: 0 2px 5px 0 rgb(0 0 0 / 16%), 0 2px 10px 0 rgb(0 0 0 / 12%);
}

.sidebar-sticky {
  position: relative;
  top: 0;
  height: calc(100vh - 48px);
  padding-top: 0.5rem;
  overflow-x: hidden;
  overflow-y: auto; /* Scrollable contents if viewport is shorter than content. */
}

</style>
    <title>Document</title>
</head>
<body>
    
    <!--Main Navigation-->
<header>
    <!-- Sidebar -->
    <nav id="sidebarMenu" class="collapse d-lg-block sidebar collapse bg-white">
      <div class="position-sticky">
        <div class="list-group list-group-flush mx-3 mt-4">
          <a
            href="/userDashboard"
            class="list-group-item list-group-item-action py-2 ripple"
            aria-current="true"
          >
            <i class="fas fa-tachometer-alt fa-fw me-3"></i><span>Main dashboard</span>
          </a>
          <a href="/userDashboard" class="list-group-item list-group-item-action py-2 ripple ">
            <i class="fas fa-chart-area fa-fw me-3"></i><span>Dashboard</span>
          </a>
          <a href="/bookvisit" class="list-group-item list-group-item-action py-2 ripple active"
            ><i class="fas fa-building fa-fw me-3"></i><span>Book Visit</span></a
          >
          <a href="/calender" class="list-group-item list-group-item-action py-2 ripple"
          ><i class="fas fa-calendar fa-fw me-3"></i><span>Calendar</span></a
        >
          <a href="/bookhistory" class="list-group-item list-group-item-action py-2 ripple"
            ><i class="fas fa-users fa-fw me-3"></i><span>Visit History</span></a
          >
          <a href="/profile" class="list-group-item list-group-item-action py-2 ripple"
            ><i class="fas fa-lock fa-fw me-3"></i><span>Profile</span></a
          >
          
          <a href="/logout" class="list-group-item list-group-item-action py-2 ripple">
            <i class="fas fa-chart-pie fa-fw me-3"></i><span>LogOut</span>
          </a>
         
        </div>
      </div>
    </nav>
    <!-- Sidebar -->
  
    <!-- Navbar -->
    <nav id="main-navbar" class="navbar navbar-expand-lg navbar-light bg-white fixed-top">
      <!-- Container wrapper -->
      <div class="container-fluid">
        <!-- Toggle button -->
        <button
          class="navbar-toggler"
          type="button"
          data-mdb-toggle="collapse"
          data-mdb-target="#sidebarMenu"
          aria-controls="sidebarMenu"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <i class="fas fa-bars"></i>
        </button>
  
        <!-- Brand -->
        <a class="navbar-brand" href="#">
         <img
            src="/images/logo.png"
            height="25"
            alt="MDB Logo"
            loading="lazy"
          />
        </a>
       
  
        
    </nav>
    <!-- Navbar -->
  </header>
  <!--Main Navigation-->
  
  <!--Main layout-->
  <main style="margin-top: 58px">
    <div class="container card pt-4   " style="margin-right: 150px;">
        <form method="post" action="/bookvisit">
            <!-- 2 column grid layout with text inputs for the first and last names -->
            <div class="row mb-4">
              <div class="col ">
                <div class="form ">
                    <label class="form-label" for="form6Example1">First name</label>
                  <input type="text" id="form6Example1" class="form-control" name="fName"  value="<%= user.fName %>" disabled/>
                </div>
              </div>
              <div class="col">
                <div class="form">
                    <label class="form-label" for="form6Example2">Last name</label>
                  <input type="text" id="form6Example2" class="form-control" name="lName" value="<%= user.lName %>" disabled/>
                </div>
              </div>
            </div>
           <div class="row mb-4">
              <div class="col ">
                <div class="form ">
                    <label class="form-label" for="form6Example1">Address</label>
                  <input type="text" id="form6Example1" class="form-control" name="address" value="<%= user.Address %>" disabled/>
                </div>
              </div>
              <div class="col">
                <div class="form">
                    <label class="form-label" for="form6Example2">Contact</label>
                  <input type="text" id="form6Example2" class="form-control" name="contact" value="<%= user.contact %>" disabled/>
                </div>
              </div>
            </div>
            <hr>
          <div class="row mb-4">
              <div class="col ">
                <div class="form ">
                    <label class="form-label" for="form6Example1">Inmate First Name</label>
                  <input type="text" id="form6Example1" class="form-control" name="fNameInmate" required />
                </div>
              </div>
              <div class="col ">
                <div class="form ">
                    <label class="form-label" for="form6Example1">Inmate Last Name</label>
                  <input type="text" id="form6Example1" class="form-control" name="lNameInmate" required />
                </div>
              </div>
              <div class="col">
                <div class="form">
                    <label class="form-label" for="form6Example2">Sentance/ Year</label>
                  <input type="date" id="form6Example2" class="form-control" name="sentanceyear" required />
                </div>
              </div>
            </div>
           
          <div class="row mb-4">
            <div class="col ">
              <div class="form mb-4">
                <label class="form-label" for="form6Example7">Crime Committed</label>
              <textarea class="form-control" id="form6Example7" rows="4" name="crime" required></textarea>
            </div>
            </div>
            <div class="col ">
              <div class="form mb-4">
                <label class="form-label" for="form6Example7">List Items To bring to Inmate</label>
              <textarea class="form-control" id="form6Example7" rows="4" name="items"></textarea>
            </div>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col ">
               <!-- Message input -->
            <div class="form mb-4">
              <label class="form-label" for="form6Example7">Additional information</label>
            <textarea class="form-control" id="form6Example7" rows="4 " name="additionalInfo"></textarea>
          </div>
            </div>
            <div class="col">
              <div class="form">
                  <label class="form-label" for="form6Example2">Appointment Date</label>
                <input type="date" id="form6Example2" class="form-control" name="appointmentDate" required />
                
              </div>
            </div>
          </div>
        
         
          
           
          
            <!-- Checkbox -->
            <div class="form-check d-flex justify-content-center mb-4">
              <input class="form-check-input me-2" type="checkbox" value="" id="form6Example8" checked />
              <label class="form-check-label" for="form6Example8"> I Aggree to the above information.  </label>
            </div>
          
            <!-- Submit button -->
            <button type="submit" class="btn btn-primary btn-block mb-4">Place Booking</button>
          </form>


        
    </div>
       

    </div>
  </main>
  <!--Main layout-->
  <script
  type="text/javascript"
  src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.js"
></script>
</body>
</html>