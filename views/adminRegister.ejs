<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Font Awesome -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
rel="stylesheet"
/>
<!-- Google Fonts -->
<link
href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"
rel="stylesheet"
/>
<!-- MDB -->
<link
href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.css"
rel="stylesheet"
/>
    <title>Document</title>
</head>
<body>
  <div class="container">
    <div class="card " style="width: 50%; margin-top: 5%;">
        <div class="card-item p-5"style="">
                <!-- Pills navs -->
<ul class="nav nav-pills nav-justified mb-3" id="ex1" role="tablist">
   
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="tab-register" data-mdb-toggle="pill" href="#pills-register" role="tab"
        aria-controls="pills-register" aria-selected="true">Register</a>
    </li>
  </ul>
  <!-- Pills navs -->
  
 
    <div class="tab-pane fade show active" id="pills-register" role="tabpanel" aria-labelledby="tab-register">
      <form action="/register" method="post">
        
        <div class="row mb-4">
          <div class="col-md-6">
            <div class="form-outline ">
                
              <input type="text" id="form6Example1" class="form-control" name="fName"  />
              <label class="form-label" for="form6Example1">First name</label>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-outline">
                
              <input type="text" id="form6Example2" class="form-control" name="lName" />
              <label class="form-label" for="form6Example2">Last name</label>
            </div>
          </div>
        </div>
        <div class="row mb-4">
          <div class="col-md-6">
            <div class="form-outline">
              <input type="text" id="form6Example1" class="form-control" name="email"  />
              <label class="form-label" for="form6Example1">Email</label>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-outline">  
              <input type="text" id="form6Example2" class="form-control" name="contact" />
              <label class="form-label" for="form6Example2">Contact</label>
            </div>
          </div>
        </div>
        <div class="row mb-4">
          <div class="col-md-6">
            <div class="form-outline ">
               
              <input type="text" id="form6Example1" class="form-control" name="digitalAddress"  />
              <label class="form-label" for="form6Example1">Digital Address</label>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-outline ">
                
              <input type="text" id="form6Example2" class="form-control" name="Address" />
              <label class="form-label" for="form6Example2">Residential Address</label>
            </div>
          </div>
        </div>
      
  
        <!-- Username input -->
        <div class="form-outline mb-4">
            <input type="text" id="ID" name="ID" class="form-control" />
            <label class="form-label" for="ID">Ghana Card</label>
          </div>
          
        <!-- Password input -->
        <div class="form-outline mb-4">
          <input type="password" id="password" name="password" class="form-control" />
          <label class="form-label" for="password">Password</label>
          <input type="text" name="role" value="Admin" hidden>
        </div>
  
        <!-- Repeat Password input -->
        <div class="form-outline mb-4">
          <input type="password" id="registerRepeatPassword" name="registerRepeatPassword" class="form-control" />
          <label class="form-label" for="registerRepeatPassword">Repeat password</label>
        </div>
  
        <!-- Checkbox -->
        <div class="form-check d-flex justify-content-center mb-4">
          <input class="form-check-input me-2" type="checkbox" value="" id="registerCheck" checked
            aria-describedby="registerCheckHelpText" />
          <label class="form-check-label" for="registerCheck">
            I have read and agree to the terms
          </label>
        </div>
  
        <!-- Submit button -->
        <button type="submit" class="btn btn-primary btn-block mb-3">Register</button>
      </form>
    </div>
  </div>
  <!-- Pills content -->
        </div>
      

    </div>
  

  <!-- MDB -->
<script
type="text/javascript"
src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/6.4.0/mdb.min.js"
></script>
</body>
</html>